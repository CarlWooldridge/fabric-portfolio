annotation PBI_ProTooling = ["DirectLakeOnOneLakeInWeb","WebModelingEdit"]

ref table Fact_JobPostings
ref table Dim_Date
ref table _Measures
ref table Bridge_ScoreComponents
ref table Writeback_Action
ref table Writeback_Outcome
ref table Fact_Messages
ref table Fact_WriteBack


